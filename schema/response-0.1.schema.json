{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ammend/handoffX/schema/response-0.1.schema.json",
  "title": "handoffX 0.1 Response Metadata",
  "type": "object",
  "required": ["handoffx", "kind", "handoff_id", "base_revision", "base_sha256", "responder", "disposition", "created_at"],
  "properties": {
    "handoffx": { "const": "0.1" },
    "kind": { "const": "handoff-response" },
    "handoff_id": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "integer", "minimum": 1 },
    "base_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "responder": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["accepted", "needs-info", "rejected"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
